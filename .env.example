# AWS Auth Mode (TOKEN or CREDENTIALS)
AWS_AUTH_MODE="TOKEN"
AWS_BEARER_TOKEN_BEDROCK="your_aws_bedrock_token"
AWS_DEFAULT_REGION="us-east-1"

# Endpoint URL override (optional, e.g., if using a custom Bedrock proxy)
# AWS_BEDROCK_ENDPOINT_URL="https://your-custom-endpoint.com"

# Standard AWS IAM Credentials (if not using TOKEN auth mode)
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_SESSION_TOKEN="your_session_token"

# Anthropic API Key (Fallback if AWS Bedrock is not configured)
# ANTHROPIC_API_KEY="your_anthropic_api_key"

# OpenAI API Key (For other evaluation models)
# OPENAI_API_KEY="your_openai_api_key"

# Groq API Key (For Llama / Mixtral models)
# GROQ_API_KEY="your_groq_api_key"
